{
	"name": "pi-scratchpad",
	"version": "0.0.0-development",
	"description": "pi extension: a per-session scratchpad directory for temporary files, kept out of your project",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"scratchpad"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Toshimichi0915/pi-scratchpad.git"
	},
	"bugs": {
		"url": "https://github.com/Toshimichi0915/pi-scratchpad/issues"
	},
	"homepage": "https://github.com/Toshimichi0915/pi-scratchpad#readme",
	"files": [
		"extensions"
	],
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/npm",
			"@semantic-release/github"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@earendil-works/pi-coding-agent": "^1.0.2",
		"@types/node": "^26.6.4",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc"
	}
}
